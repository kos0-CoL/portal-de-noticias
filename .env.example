# ---------------------------------------------------------------------------
# Copia este archivo como ".env" y completa los valores.
# ---------------------------------------------------------------------------

# --- Base de datos (PostgreSQL) ---
# Local con Docker:  docker compose up -d
# Supabase / Neon:   usá el connection string "pooled" que te da el panel
DATABASE_URL="postgresql://saladillo:saladillo@localhost:5432/saladillo_noticias?schema=public"

# --- Sesion del panel de administracion ---
# Generá algo aleatorio:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="cambiar-por-un-secreto-largo-de-al-menos-32-caracteres"

# --- Cifrado de credenciales (API Keys de IA, tokens de redes) ---
# 32 bytes en hex (64 caracteres). Lo mismo: randomBytes(32).toString('hex')
ENCRYPTION_KEY="cambiar-por-32-bytes-en-hexadecimal-64-caracteres"

# --- URL publica del portal (para meta tags, sitemap y difusion) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Proveedor de IA (tambien se puede cargar desde el panel: /admin/ia) ---
# Valores de AI_PROVIDER: openai | openrouter | groq | anthropic | gemini | custom
AI_PROVIDER="openai"
AI_MODEL="gpt-4o-mini"
AI_API_KEY=""
AI_BASE_URL=""

# --- Clima (Open-Meteo no requiere API key) ---
# Coordenadas por defecto: Saladillo, Buenos Aires
WEATHER_LAT="-35.6386"
WEATHER_LON="-59.7789"

# --- Tareas programadas ---
# Protege el endpoint /api/cron con este token (Bearer). Vacio = deshabilitado.
CRON_SECRET=""
ENABLE_INTERNAL_SCHEDULER="false"

# --- Difusion en redes (opcional) ---
TELEGRAM_BOT_TOKEN=""
